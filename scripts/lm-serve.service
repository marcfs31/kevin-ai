# systemd user unit for bin/lm-serve. Install (as the user that owns the checkout):
#   mkdir -p ~/.config/systemd/user && cp scripts/lm-serve.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now lm-serve
#   sudo loginctl enable-linger "$USER"      # start at boot, without a login
# Optional API key: put LM_SERVE_API_KEY=... in ~/.config/lm-serve.env (chmod 600).
# Health: curl -s http://127.0.0.1:8080/health   Logs: journalctl --user -u lm-serve
# Paths assume the checkout in ~/small-llm-in-c and the model in ~/models/qwen3.5-4b; edit
# ExecStart for anything else. A missing model makes lm-serve exit 1, and after three failed
# starts in two minutes systemd stops retrying and shows the unit as failed.
[Unit]
Description=small-llm-in-c OpenAI-compatible endpoint (lm-serve)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/small-llm-in-c
EnvironmentFile=-%h/.config/lm-serve.env
ExecStart=%h/small-llm-in-c/bin/lm-serve --model %h/models/qwen3.5-4b --weights %h/models/qwen3.5-4b/model.q8.safetensors --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
